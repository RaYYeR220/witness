{
  "name": "console",
  "version": "0.1.0",
  "description": "Witness console: landing page and explorer UI (Vue 3)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixture": "node scripts/make-fixture.mjs",
    "record-replay": "node scripts/record-replay.mjs",
    "build:replay": "vue-tsc -p tsconfig.json --noEmit && vite build --mode replay",
    "build:lib": "vue-tsc -p tsconfig.json --noEmit && vite build --mode lib",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@witness/verify": "workspace:*",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
