{
  "name": "@witness/anchor",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "bootstrap:identities": "tsx --env-file-if-exists=.env scripts/bootstrap-identities.ts",
    "trail:smoke": "tsx --env-file-if-exists=.env scripts/trail-smoke.ts",
    "milestones:hornet": "tsx scripts/hornet-milestones.ts"
  },
  "dependencies": {
    "@iota/audit-trails": "0.1.3",
    "@iota/identity-wasm": "1.9.7-beta.1",
    "@iota/iota-sdk": "1.16.0",
    "@witness/verify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
