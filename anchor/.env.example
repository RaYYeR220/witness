# Witness anchor service. Copy to anchor/.env (gitignored) and adjust.

IOTA_NETWORK=testnet

# Network-specific values follow IOTA_NETWORK. Uncomment only to override them; the values
# shown are the testnet defaults.
# IOTA_RPC_URL=https://api.testnet.iota.cafe
# IOTA_GRAPHQL_URL=https://graphql.testnet.iota.cafe
# IOTA_EXPLORER_URL=https://explorer.iota.org

# Audit Trail package (iotaledger/notarization audit-trail-move/Move.lock): the latest id is
# the one we call, the original id is what Move type tags use.
# IOTA_AUDIT_TRAIL_PKG_ID=0x385307a0da2859851d5820646efe617e1a957a3ea172a0f2a63487c987c93d88
# IOTA_AUDIT_TRAIL_ORIGINAL_PKG_ID=0x51368931f28620c7f65b4ae2c5167b42390e69729357a6347be378755b46e7df
# TF components (iotaledger/product-core components_move/Move.lock): capability and time lock types.
# IOTA_TF_COMPONENTS_PKG_ID=0xd45732966e800d52b28044cf3758088bfc4606618dfc96d1ec9b21587379b3d9
# Identity package, original id (iotaledger/identity iota_identity/Move.lock): DID objects must be of its type.
# IOTA_IDENTITY_ORIGINAL_PKG_ID=0x222741bbdff74b42df48a7b4733185e9b24becb8ccfbafe8eac864ab4e4cc555

# IOTA CLI keystore and the entry (0x address or alias) that sends transactions and pays gas.
# Needed only for writes (bootstrap-identities, trail-smoke, ANCHOR_LOOP); the HTTP resolver and
# the checkpoint read API run without it.
# ANCHOR_KEYSTORE_PATH=/home/you/.iota/iota_config/iota.keystore
# ANCHOR_ADDRESS=0x...

# Private component keys, identities.json and the trail state live here. Never commit it.
SECRETS_DIR=secrets
# Public identity file written by bootstrap-identities and served at /identities.
# Defaults to deploy/identity/<IOTA_NETWORK>.json in the repository.
# ANCHOR_IDENTITIES_FILE=../deploy/identity/testnet.json

ANCHOR_HOST=127.0.0.1
ANCHOR_PORT=7300
# Protects the admin endpoints (POST /checkpoints/run, as "Authorization: Bearer <token>");
# at least 16 characters. Unset: admin endpoints are disabled.
# ANCHOR_ADMIN_TOKEN=

# Reuse an existing trail instead of the one recorded in SECRETS_DIR.
# ANCHOR_TRAIL_ID=0x...
# ANCHOR_GAS_BUDGET=50000000
# ANCHOR_RESOLVE_CACHE_MS=60000

# ---------------------------------------------------------------- checkpoints
# Anchoring loop: every ANCHOR_EVERY milestones it commits the window to the Audit Trail and
# mirrors it to the private Tangle as a signed witness.anchor message. Off unless set to on;
# needs ANCHOR_KEYSTORE_PATH, ANCHOR_ADDRESS and ANCHOR_POLICY_PATH.
# ANCHOR_LOOP=on
# Writer policy (witness_core.policy JSON) whose hash every checkpoint commits to; use the
# same file the relay enforces.
# ANCHOR_POLICY_PATH=../deploy/policy.json
# witness-api serving GET /milestones?from=&to= (or scripts/hornet-milestones.ts in dev).
# ANCHOR_API_URL=http://127.0.0.1:7200
# witness-relay (POST /upload?node=). 5555 is the legacy port; if the Android emulator (adb)
# holds it locally, run the relay on another port and point this at it.
# ANCHOR_RELAY_URL=http://127.0.0.1:5555
# ANCHOR_RELAY_NODE=iota-hornet
# Milestones per checkpoint: 60 in production, 12 for demos.
# ANCHOR_EVERY=60
# First milestone of the first window (only used before the first checkpoint exists).
# ANCHOR_START_INDEX=1
# Checkpoint `domain`; defaults to the domain DID of the identities file.
# ANCHOR_DOMAIN=
# Network name of the private Tangle, as bundles and the verifier pin it.
# ANCHOR_NETWORK_NAME=private_tangle1
# Component whose #sig-1 key (SECRETS_DIR/<name>/sig-1.jwk.json) signs the mirror envelopes.
# ANCHOR_IDENTITY=anchor
# Loop state (checkpoints, pending append, mirror chain). Default: SECRETS_DIR/../data/anchor-state.json.
# Losing it is recoverable (the chain is rebuilt from the trail), but keep it with the secrets backup.
# ANCHOR_STATE_PATH=data/anchor-state.json
# Development only: commit msgCount 0 when the milestone source does not report it (the HORNET
# stub). Without it such a window is not anchored, so a checkpoint never commits a made-up count.
# ANCHOR_ALLOW_MISSING_MSGCOUNT=0
# ANCHOR_POLL_MS=10000
# ANCHOR_HTTP_TIMEOUT_MS=10000
