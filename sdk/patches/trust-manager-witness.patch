+    
+
+    # WITNESS: producer-signed uploads
+    def __witness_enabled(self):
+        return bool(os.environ.get("WITNESS_KEY_PATH") or os.environ.get("WITNESS_COMPONENT"))
+
+    def __update_iota_score_signed(self, iota_api_url, iota_node_url, id, score):
+        """
+        Upload the score as an envelope signed with this component's own key, with salted
+        commitments to the rel/sec/rep sub-scores. The signing runs in the witness_sdk
+        interpreter (WITNESS_PYTHON); the salts it returns stay in disclosures.jsonl.
+        """
+        stored = self.storage.read_item(id) or {}
+        commitments = {}
+        for short, name in (("rel", "reliability"), ("sec", "security"), ("rep", "reputation")):
+            if name in stored:
+                commitments[short] = stored[name]
+        request = {
+            "relay_url": "http://" + iota_api_url,
+            "node": iota_node_url,
+            "tag": "trust.score",
+            "body": {"score": score, "id": id},
+            "commitments": commitments,
+        }
+        try:
+            proc = subprocess.run(
+                [os.environ.get("WITNESS_PYTHON", sys.executable), "-m", "witness_sdk"],
+                input=json.dumps(request), capture_output=True, text=True, timeout=60,
+            )
+            reply = json.loads(proc.stdout.strip().splitlines()[-1]) if proc.stdout.strip() else {}
+            if proc.returncode != 0:
+                raise RuntimeError("signed upload failed: " + (proc.stderr.strip() or json.dumps(reply)))
+            salts = reply.get("salts") or {}
+            if salts:
+                path = os.environ.get("WITNESS_DISCLOSURES_PATH", "disclosures.jsonl")
+                block_id = (reply.get("witness") or {}).get("blockId")
+                with open(path, "a") as f:
+                    f.write(json.dumps({"id": id, "blockId": block_id, "values": commitments, "salts": salts}) + "\n")
+            print(reply.get("return_payload", reply))
+        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
+            print(f"[TrustManager] Error updating entity {error}")
