# Witness console: the built Vue app plus a same-origin proxy to the witness-api at /api/.
# Rendered at container start by the nginx image (envsubst, WITNESS_* variables only).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    client_max_body_size 1m;

    # Look the API up per request (Docker's or the cluster's DNS, from /etc/resolv.conf), so a
    # restarted API with a new address is found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $witness_api http://${WITNESS_API_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Live event stream (SSE): no buffering, long reads.
    location = /api/stream {
        include /etc/nginx/conf.d/security-headers.inc;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $witness_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        include /etc/nginx/conf.d/security-headers.inc;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $witness_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Content-hashed build output: cache for good.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths get index.html, which is never cached.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
