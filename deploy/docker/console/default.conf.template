# Witness console: the built Vue app plus two same-origin proxies, rendered at container start
# by the nginx image (envsubst, WITNESS_* variables only):
#   /api/             -> witness-api (messages, bundles, stream, report pages)
#   /anchor/resolve/  -> the anchor service's DID resolver, and nothing else of that service:
#                        its admin endpoints (POST /checkpoints/run) stay unreachable.
# Proxied answers keep the upstream's own headers; the console's CSP is for the app's pages
# (the API's HTML report pages carry their own).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    client_max_body_size 1m;

    # Look the upstreams up per request (Docker's or the cluster's DNS, from /etc/resolv.conf),
    # so a restarted service with a new address is found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $witness_api http://${WITNESS_API_UPSTREAM};
    set $witness_anchor http://${WITNESS_ANCHOR_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Live event stream (SSE): no buffering, long reads, Last-Event-ID passed through.
    location = /api/stream {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $witness_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $witness_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Read-only DID resolution for step 4 of the in-browser verifier. GET only, no redirects.
    location /anchor/resolve/ {
        limit_except GET { deny all; }
        rewrite ^/anchor(/resolve/.*)$ $1 break;
        proxy_pass $witness_anchor;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_redirect off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }

    location /anchor/ {
        return 404;
    }

    # Content-hashed build output: cache for good.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths get index.html, which is never cached.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
