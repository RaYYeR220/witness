# Settings of the compose files in this directory. Copy to deploy/compose/.env (gitignored);
# docker compose reads it from here. Paths are relative to this directory or absolute.

# Legacy aeriOS messages relay host port (5555 is also adb's; 5556 with an Android emulator).
RELAY_PORT=5555

# Where the run-time secrets live (generated by setup-secrets.sh, component keys from
# anchor/scripts/bootstrap-identities.ts). Mounted read-only, one file per service need.
WITNESS_SECRETS_DIR=../../secrets

# Database owner's password for a base stack created before setup-secrets.sh generated one
# (the old local stack used "witness"). Fresh setups leave it unset: a random password goes to
# secrets/postgres/postgres.password.
# WITNESS_PG_PASSWORD=witness

# Anchor wallet: the IOTA CLI keystore FILE (only the keystore, never a directory that also
# holds recovery phrases) and the keystore entry (0x address or alias) that pays gas and holds
# the trail's writer capability. On Linux the file must be readable by uid 1000.
WITNESS_IOTA_KEYSTORE=/home/you/.iota/iota_config/iota.keystore
WITNESS_ANCHOR_ADDRESS=0x...
# Address the console's verifier accepts as the trail's writer (default: WITNESS_ANCHOR_ADDRESS;
# set it when that is a keystore alias).
# WITNESS_ANCHOR_WRITER_ADDRESS=0x...

# IOTA Rebased network of the DIDs and the Audit Trail, and the trail the anchors go to.
# Empty WITNESS_TRAIL_ID: the anchor creates a trail on first start and keeps it in its state
# volume; put its id here afterwards so the API and the console build pin it.
WITNESS_REBASED_NETWORK=testnet
WITNESS_TRAIL_ID=
WITNESS_REBASED_RPC_ORIGIN=https://api.testnet.iota.cafe

# Anchoring loop: on/off, milestones per checkpoint (one trail record, i.e. gas, per window;
# 720 = about an hour, 12 = a minute for demos) and the first milestone of the first window.
WITNESS_ANCHOR_LOOP=on
WITNESS_ANCHOR_EVERY=720
WITNESS_ANCHOR_START_INDEX=1

# Writer policy shared by relay, indexer, API and anchor (relative to this directory).
WITNESS_POLICY_FILE=../policy.json

# Tags the relay seals (encrypts to the domain key, with blind-index tokens), e.g. audit.report.
WITNESS_RELAY_ENCRYPT_TAGS=

# Private Tangle coordinator keys and threshold (public; from the aeriOS iota-tangle config).
# WITNESS_COORDINATOR_KEYS=0xed3c…,0xf675…
# WITNESS_COORDINATOR_THRESHOLD=2

# Host ports (loopback only).
WITNESS_CONSOLE_PORT=8080
WITNESS_API_PORT=7200
WITNESS_RELAY_PORT=5557
WITNESS_ANCHOR_PORT=7300
WITNESS_TRUST_MANAGER_PORT=3101

# Optional bearer token for POST /messages/{id}/verify (16+ characters; empty: open).
WITNESS_VERIFY_TOKEN=
WITNESS_LOG_LEVEL=INFO
