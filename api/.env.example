# Witness Advanced Explorer API (`python -m witness_api`). Copy to .env and adjust.
# Only WITNESS_DB is required; everything else has a default or is optional.

# PostgreSQL holding the explorer's parallel database (shared with the indexer).
WITNESS_DB=postgresql://postgres:witness@127.0.0.1:5432/postgres
WITNESS_SCHEMA=witness

# Where the API listens. The node reaches it through WITNESS_ROUTE_HOST:WITNESS_PORT.
WITNESS_HOST=127.0.0.1
WITNESS_PORT=7200

# What a proof verifier pins (served at GET /config/verifier). The keys below are the
# aeriOS private Tangle's coordinator keys (public test data from eclipse-aerios/iota-tangle).
WITNESS_NETWORK=private_tangle1
WITNESS_COORDINATOR_KEYS=0xed3c3f1a319ff4e909cf2771d79fece0ac9bd9fd2ee49ea6c0885c9cb3b1248c,0xf6752f5f46a53364e2ee9c4d662d762a81efd51010282a75cd6bd03f28ef349c
WITNESS_THRESHOLD=2
# IOTA Rebased network and Audit Trail object holding the anchored checkpoints.
WITNESS_REBASED_NETWORK=testnet
WITNESS_TRAIL_ID=

# HORNET REST API: the brief's checks (c) /blocks/{id}/metadata and (d) /blocks/{id}.
# Set it empty to make no node calls at all (POST /messages/{id}/verify then answers 503).
WITNESS_HORNET_URL=http://127.0.0.1:14265
# Mount the API on the node as /api/witness/v1 via INX (leave empty to skip).
WITNESS_INX_ADDR=127.0.0.1:9029
WITNESS_NODE_ROUTE=witness/v1
# How the node (in Docker) reaches this machine.
WITNESS_ROUTE_HOST=host.docker.internal

# Optional upstreams; each one being down is reported, never fatal.
WITNESS_ORION_URL=http://127.0.0.1:1026
# WITNESS_ORION_CONTEXT=https://example.org/aerios-context.jsonld
WITNESS_ANCHOR_URL=http://127.0.0.1:7300
# Writer policy JSON (who may write which tag), summarised by GET /identity.
# WITNESS_POLICY=deploy/policy.json

# Public URL of this API, used to make resource links absolute (empty: relative links).
WITNESS_PUBLIC_BASE_URL=
# Browser origins allowed to call the API (comma-separated), e.g. the console.
WITNESS_CORS_ORIGINS=http://localhost:5173

# Bearer token the Messages API presents on POST /ingest (16+ characters; empty disables
# the HTTP fallback). Generate one, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WITNESS_INGEST_TOKEN=

# Validation and re-verification belong to `witness-indexer --validate`. Set 1 only when no
# indexer validates: the API then runs the worker for HTTP-ingested blocks itself.
WITNESS_VALIDATE=0

# POST /messages/{id}/verify asks the node on demand. Optional bearer token (16+ characters;
# empty: open), checks running at once (429 beyond), how long a fresh answer from the node
# is served instead of asking again, and how long one check may wait for a confirmation.
WITNESS_VERIFY_TOKEN=
WITNESS_VERIFY_CONCURRENCY=4
WITNESS_VERIFY_COOLDOWN_S=20
WITNESS_VERIFY_TIMEOUT_S=10
# Open GET /stream connections per server (503 beyond).
WITNESS_STREAM_MAX_SUBSCRIBERS=200
# Orion vs ledger difference that counts as drift on GET /ie/{id}/lineage.
WITNESS_DRIFT_EPSILON=0.01

# Node posture scanner (GET /posture, POST /posture/scan). POST needs this bearer token
# (16+ chars; empty disables scanning). It scans WITNESS_HORNET_URL and WITNESS_INX_ADDR;
# set a dashboard URL to let active scans try the default admin/admin login. Active probes
# (an invalid POST to a protected route, a dashboard login) run per target, and only when
# that target's host is loopback (localhost, 127.0.0.0/8, ::1) or listed here. Entries are
# compared with the URL's host name exactly (case-insensitive): no wildcards, no DNS lookup.
WITNESS_POSTURE_TOKEN=
WITNESS_POSTURE_DASHBOARD_URL=
WITNESS_POSTURE_ALLOW_ACTIVE_HOSTS=
WITNESS_POSTURE_TIMEOUT_S=5

# Signed audit reports (POST /reports -> audit.report on the Tangle). POST needs this bearer
# token (16+ chars; empty disables report writing, i.e. fails closed).
WITNESS_REPORT_TOKEN=
# The relay the report is posted through, and the node name it forwards to. The hash is
# sealed as a producer envelope with the signing key below (an Ed25519 private JWK; never
# logged). The relay's writer policy must allow this key's DID on tag audit.report.
WITNESS_RELAY_URL=http://127.0.0.1:5556
WITNESS_REPORT_RELAY_NODE=iota-hornet
WITNESS_REPORT_SIGNER_KEY=secrets/domain/sig-1.jwk.json

WITNESS_LOG_LEVEL=INFO
